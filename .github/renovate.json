{
  "extends": ["github>nickysemenza/renovate-config"],
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "groupName": "tauri",
      "matchPackageNames": ["tauri{-,/,}**", "@tauri-apps/**"],
      "matchUpdateTypes": [
        "major",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ]
    },
    {
      "groupName": "reqwest",
      "matchPackageNames": ["reqwest{/,}**"],
      "matchUpdateTypes": [
        "major",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ]
    },
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": [
        "major",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ]
    },
    {
      "groupName": "frontend js deps",
      "matchManagers": ["npm"],
      "matchUpdateTypes": [
        "major",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ]
    },
    {
      "matchUpdateTypes": ["patch", "digest"],
      "enabled": false
    }
  ]
}
