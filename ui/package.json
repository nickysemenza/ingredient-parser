{
  "name": "@ingredient-parser/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../food-wasm --target web --out-dir ../ui/src/wasm/pkg --out-name food_wasm",
    "wasm:dev": "wasm-pack build ../food-wasm --dev --target web --out-dir ../ui/src/wasm/pkg --out-name food_wasm",
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint src e2e",
    "desktop:dev": "cd ../food-app && tauri dev",
    "desktop:build": "cd ../food-app && tauri build --bundles app"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-clipboard-manager": "catalog:",
    "@tauri-apps/plugin-dialog": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
